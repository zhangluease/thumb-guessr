[Unit]
Description=thumb-guessr web game
After=network.target

[Service]
Type=simple
User=thumb-guessr
Group=thumb-guessr
WorkingDirectory=/app/thumb-guessr
Environment=NODE_ENV=production
EnvironmentFile=-/app/thumb-guessr/.env
Environment=HOST=127.0.0.1
Environment=PORT=4173
ExecStart=/usr/local/bin/node server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
