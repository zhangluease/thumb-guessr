# Producer application (local only)
PRODUCER_HOST=127.0.0.1
PRODUCER_PORT=4174

# YouTube Data API v3
YOUTUBE_API_KEY=change-me
# 可选：本机需要代理访问 Google 时填写，例如 http://127.0.0.1:7890
YOUTUBE_PROXY_URL=

# Remote MySQL
DB_HOST=124.72.50.154
DB_PORT=8736
DB_NAME=thumb_guessr
DB_USER=root
DB_PASSWORD=change-me

# Alibaba Cloud OSS（封面会先上传 OSS，数据库只保存这个公网地址）
OSS_ENABLED=true
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-public-domain.example.com
OSS_OBJECT_PREFIX=thumb-guessr/covers
